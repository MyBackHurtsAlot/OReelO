{
  "manifestVersion": 5,
  "id": "com.prplugins.sequencewheel",
  "name": "OReelO",
  "version": "0.6.1",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "requiredPermissions": {
    "localFileSystem": "request",
    "network": {
      "domains": "all"
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "sequenceWheel",
      "label": {
        "default": "OReelO"
      },
      "minimumSize": {
        "width": 280,
        "height": 260
      },
      "preferredDockedSize": {
        "width": 340,
        "height": 420
      },
      "preferredFloatingSize": {
        "width": 420,
        "height": 480
      },
      "maximumSize": {
        "width": 2000,
        "height": 2000
      }
    }
  ]
}
